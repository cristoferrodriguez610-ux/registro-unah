    <script>
        (function () {
            var saved = localStorage.getItem('dipp-theme');
            if (saved === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();

        function toggleDarkMode() {
            var html = document.documentElement;
            var isDark = html.getAttribute('data-theme') === 'dark';
            if (isDark) {
                html.removeAttribute('data-theme');
                localStorage.setItem('dipp-theme', 'light');
                swapLogo('light');
            } else {
                html.setAttribute('data-theme', 'dark');
                localStorage.setItem('dipp-theme', 'dark');
                swapLogo('dark');
            }
        }

        function swapLogo(theme) {
            var logo = document.querySelector('.dipp-header__logo-img');
            if (!logo) return;
            if (theme === 'dark') {
                logo.src = logo.src.replace('logo-unah.png', 'logo-unah-blanco.png');
            } else {
                logo.src = logo.src.replace('logo-unah-blanco.png', 'logo-unah.png');
            }
        }

        /* Aplicar logo correcto al cargar */
        document.addEventListener('DOMContentLoaded', function () {
            if (localStorage.getItem('dipp-theme') === 'dark') {
                swapLogo('dark');
            }
        });
    </script>

    
