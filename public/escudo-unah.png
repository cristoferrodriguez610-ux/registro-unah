                    </div>

                    
                    <div class="modern-form-group">
                        <label for="txt_clave">Contraseña</label>
                        <div class="input-icon-wrapper">
                            <svg class="input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            <input name="ctl00$MainContent$txt_clave" type="password" maxlength="30" id="MainContent_txt_clave" class="modern-input" AUTOCOMPLETE="OFF" placeholder="Ingresa tu contraseña" />
                            <button type="button" class="toggle-password" onclick="togglePassword(this)" tabindex="-1" aria-label="Mostrar contraseña">
